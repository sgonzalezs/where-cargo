rules_version = '2';

// Cada usuario solo puede leer y escribir sus propios datos.
// Todo lo que no esté listado aquí queda bloqueado.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Vehículo normalizado: o referencia una versión existente del catálogo
    // (model_id + variant_id) o es personalizado y trae sus datos en custom,
    // con brand_id de una marca existente o brand como texto.
    // connectors y current_battery_percent solo se aceptan por la app 1.1.0,
    // que aún los envía; las versiones nuevas ya no los guardan.
    function isValidVehicle(uid, vehicleId) {
      let v = request.resource.data;
      let modelPath = /databases/$(database)/documents/vehicle_models/$(v.get('model_id', '-'));
      let custom = v.get('custom', {});
      let brandPath = /databases/$(database)/documents/vehicle_brands/$(custom.get('brand_id', '-'));
      return v.id == vehicleId
        && v.user_id == uid
        && v.keys().hasOnly([
          'id', 'user_id', 'model_id', 'variant_id', 'connectors', 'custom',
          'name', 'year', 'current_battery_percent', 'is_primary',
          'created_at', 'updated_at'
        ])
        && v.year is int
        && (
          (v.get('model_id', null) is string
            && !('custom' in v)
            && exists(modelPath)
            && v.variant_id in get(modelPath).data.variants)
          || (!('model_id' in v) && !('variant_id' in v) && v.custom is map
            && ('brand_id' in custom ? exists(brandPath) : custom.brand is string))
        );
    }

    // Límite de reportes por día: report_window_start marca el inicio de la
    // ventana de 24 h y report_window_count los reportes hechos en ella.
    // Solo puede quedar igual, abrir una ventana nueva (si la anterior
    // venció) o sumar 1 hasta el máximo.
    function isValidReportWindow() {
      let d = request.resource.data;
      let before = resource == null ? {} : resource.data;
      let start = before.get('report_window_start', null);
      let count = before.get('report_window_count', 0);
      return (d.get('report_window_start', null) == start
          && d.get('report_window_count', 0) == count)
        || (d.report_window_start == request.time
          && d.report_window_count == 1
          && (start == null || request.time > start + duration.value(1, 'd')))
        || (start != null
          && d.report_window_start == start
          && d.report_window_count == count + 1
          && d.report_window_count <= 20
          && request.time < start + duration.value(1, 'd'));
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'display_name', 'email', 'photo_url', 'platform',
          'created_at', 'last_login_at', 'stats_consent',
          'report_window_start', 'report_window_count'
        ])
        && isValidReportWindow();

      match /vehicles/{vehicleId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidVehicle(uid, vehicleId);
      }
    }

    // Reportes de la comunidad. El resumen público se escribe en la misma
    // transacción que el reporte (last_report_id) y el reporte exige haber
    // actualizado los límites del usuario (30 min por estación, 20 al día).
    match /community_stations/{stationId} {
      allow read: if true;
      allow create, update: if request.auth != null && isValidCommunityStation();

      function isValidCommunityStation() {
        let d = request.resource.data;
        let report = getAfter(/databases/$(database)/documents/community_stations/$(stationId)/reports/$(d.last_report_id));
        return d.keys().hasOnly([
            'source_ids', 'lat', 'lng', 'geohash', 'name', 'recent',
            'connectors', 'tags', 'free_votes', 'paid_votes', 'price_kwh',
            'report_count', 'last_report_id', 'updated_at'
          ])
          && d.source_ids is list && d.source_ids.size() >= 1 && d.source_ids.size() <= 10
          && d.lat is number && d.lng is number
          && d.geohash is string && d.geohash.size() == 7
          && d.recent is list && d.recent.size() >= 1 && d.recent.size() <= 10
          && d.recent[0].at > request.time - duration.value(10, 'm')
          && d.recent[0].at < request.time + duration.value(10, 'm')
          && d.connectors is map && d.connectors.size() <= 30
          && d.tags is map && d.tags.size() <= 10
          && d.free_votes is int && d.paid_votes is int
          && (d.price_kwh == null || (d.price_kwh is number && d.price_kwh > 0 && d.price_kwh < 10000))
          && d.updated_at == request.time
          && d.last_report_id is string
          && report.data.created_at == request.time
          && report.data.user_id == request.auth.uid
          && (resource == null
            ? d.report_count == 1
            : d.report_count == resource.data.report_count + 1
              && d.lat == resource.data.lat && d.lng == resource.data.lng);
      }

      // Los reportes guardan quién los hizo: no se pueden leer desde la app
      match /reports/{reportId} {
        allow create: if request.auth != null && isValidReport();

        function isValidReport() {
          let d = request.resource.data;
          let uid = request.auth.uid;
          let contributor = /databases/$(database)/documents/community_stations/$(stationId)/contributors/$(uid);
          let user = /databases/$(database)/documents/users/$(uid);
          let windowAfter = getAfter(user).data;
          return d.keys().hasOnly([
              'user_id', 'status', 'connectors', 'tags', 'is_free',
              'price_kwh', 'vehicle_model_id', 'created_at'
            ])
            && d.user_id == uid
            && d.created_at == request.time
            && d.status in ['working', 'partial', 'not_working']
            && d.connectors is list && d.connectors.size() <= 8
            && d.tags is list && d.tags.size() <= 5
            && (d.is_free == null || d.is_free is bool)
            && (d.price_kwh == null || (d.price_kwh is number && d.price_kwh > 0 && d.price_kwh < 10000))
            && (d.vehicle_model_id == null || d.vehicle_model_id is string)
            // Límite por estación (las reglas del contribuidor validan los 30 min)
            && getAfter(contributor).data.last_report_at == request.time
            // Límite diario: la ventana del usuario cambió en esta escritura
            && (windowAfter.get('report_window_start', null) == request.time
              || (exists(user)
                && windowAfter.get('report_window_count', 0)
                  == get(user).data.get('report_window_count', 0) + 1));
        }
      }

      match /contributors/{uid} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['last_report_at'])
          && request.resource.data.last_report_at == request.time
          && (resource == null
            || request.time > resource.data.last_report_at + duration.value(30, 'm'));
      }
    }

    // Catálogo de vehículos: lectura pública, solo se publica con
    // tool/seed_vehicle_catalog.mjs (credenciales de administrador).
    match /vehicle_brands/{brandId} {
      allow read: if true;
    }
    match /vehicle_models/{modelId} {
      allow read: if true;
    }
    match /catalog_meta/{docId} {
      allow read: if true;
    }
  }
}
